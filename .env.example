# Copy this file to .env in the repo root (same folder as this file). Never commit .env.
# Without PayPal keys the server refuses to start unless PARABLE_MOCK_PAYPAL=1 (offline development with a fake PayPal).

# --- PayPal (sandbox) ---
# Client ID of your sandbox REST app (developer.paypal.com > Apps & Credentials).
PAYPAL_CLIENT_ID=
# Secret of the same app.
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing money, "live" for real money. Keep "sandbox" for the hackathon.
PAYPAL_ENV=sandbox
# ID of the webhook you create in the PayPal dashboard. Without it every webhook is stored as unverified and ignored.
PAYPAL_WEBHOOK_ID=
# Set to 1 to use the built-in fake PayPal. Offline development only: it lets anyone sign in as anyone and approve orders without paying.
PARABLE_MOCK_PAYPAL=0
# Set to production on a real deployment. The server then refuses to start with the fake PayPal, PRICE_SOURCE=sim or a weak SESSION_SECRET.
PARABLE_ENV=
# Payout email for the seeded demo creators. Use a PayPal sandbox account you own. Empty keeps example.com addresses.
DEMO_PAYOUT_EMAIL=

# --- Site ---
# The address people use to reach the site. PayPal return and login URLs are built from it. No slash at the end.
PUBLIC_BASE_URL=http://localhost:8000
# Long random text (at least 32 characters) that signs login cookies. Create one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty only for local use: a random secret is then made at each start.
SESSION_SECRET=
# Share of each sale kept by the platform, in basis points (100 = 1%). 1000 = 10%.
PLATFORM_FEE_BPS=1000
# Path of the SQLite file. A relative path is relative to the folder you start the server in (engine/).
DATABASE_PATH=parable.db
# Set to 1 to create 3 demo creators and their demo agents on start. Safe to leave on: it never adds duplicates.
PARABLE_DEMO_SEED=0

# --- Market data ---
# "live" reads real prices. "sim" uses a simulated price (only for tests).
PRICE_SOURCE=live
# Set to 1 to never call market data websites. Only the bundled sample files and uploads work. No internet needed.
MARKETS_OFFLINE=0
# Free key from twelvedata.com. Adds stocks. Leave empty to skip.
TWELVE_DATA_KEY=
# Seconds between checks of a running agent.
BOT_INTERVAL_S=15

# --- AI: platform keys (used for the free allowance and the AI due diligence report) ---
# Google AI Studio key. Powers the Gemini and Gemma models, AI due diligence and the AI shopper.
GEMINI_API_KEY=
# Comma-separated Gemini model names to offer. Empty = one default model if a key exists.
GEMINI_MODELS=
# Comma-separated Gemma model names to offer. Empty = none.
GEMMA_MODELS=
# Autoloops key for the Jev models (free credit at autoloops.ai/console).
AUTOLOOPS_API_KEY=
# Comma-separated Jev model names to offer.
JEV_MODELS=gemma-4-31b-it,deepseek-v4.1-flash
# Model that writes due diligence reports and shopper picks, as provider:model.
AI_ANALYST_BRAIN=gemini:gemini-3.5-flash-lite
# Free AI builds per visitor per day on the platform keys. A visitor's own key has no limit.
AI_FREE_TRIES_PER_DAY=5
# Optional Anthropic key for the Claude analyst (only used if AI_ANALYST_BRAIN starts with claude:).
ANTHROPIC_API_KEY=
# Claude model names for that analyst, comma-separated.
CLAUDE_MODELS=

# --- Limits (defaults are fine) ---
UPLOAD_MAX_BYTES=5000000
UPLOAD_MAX_ROWS=200000
MAX_LIVE_RUNS_PER_ACCOUNT=5
MAX_AGENTS_PER_ACCOUNT=50
MAX_VERSIONS_PER_AGENT=100
MAX_DATASETS_PER_ACCOUNT=20
MAX_JOBS_PER_ACCOUNT=2
BENCHMARK_MAX_MODELS=6
RATE_LAB_PER_MINUTE=30
RATE_AI_PER_MINUTE=10
RATE_PROOFS_PER_HOUR=30
RATE_PURCHASES_PER_HOUR=20
TRACK_LEASE_SECONDS=2592000
MAX_RUN_POINTS_PER_RUN=20000
